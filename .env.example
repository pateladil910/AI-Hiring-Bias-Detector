# ─── Application ─────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
POSTGRES_DB=hiring_bias_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres123
DB_HOST=localhost
DB_PORT=5432

# ─── Auth & Security ──────────────────────────────────────────────────────────
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_64_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=change_me_to_another_strong_random_secret_for_refresh
REFRESH_TOKEN_EXPIRES_IN=7d

# ─── Email Provider (Resend / SendGrid / SMTP / Dev Console) ───────────────────
EMAIL_PROVIDER=console # Options: console | resend | sendgrid | smtp
RESEND_API_KEY=re_your_resend_api_key_here
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
FROM_EMAIL=noreply@fairhire.io

# ─── Redis Caching & Rate Limiting ────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── AI Microservice ──────────────────────────────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
ANTHROPIC_API_KEY=your_claude_api_key_here
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# ─── CORS ─────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:5000
